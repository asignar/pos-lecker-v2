        function calculateModalChange() {
            const cartTotal = state.cart.reduce((sum, i) => sum + (i.sellPrice * i.qty), 0);
            const deliveryFee = parseFloat(document.getElementById('maxim-fee').value) || 0;
            const grandTotal = cartTotal + deliveryFee;

            const cash = parseFloat(document.getElementById('modal-cash-given').value) || 0;
            const change = cash - grandTotal;
            const changeEl = document.getElementById('modal-change-due');

            if (change >= 0) {
                changeEl.innerText = formatPHP(change);
                changeEl.className = 'w-full px-3 py-2 bg-emerald-100 border border-emerald-300 rounded-xl text-sm font-black text-emerald-800 flex items-center';
            } else {
                changeEl.innerText = '₱0.00';
                changeEl.className = 'w-full px-3 py-2 bg-slate-200/70 border border-slate-300 rounded-xl text-sm font-extrabold text-slate-500 flex items-center';
            }
        }

        function confirmCheckout(e) {
            e.preventDefault();
            if (state.cart.length === 0) return;

            const cartTotal = state.cart.reduce((sum, i) => sum + (i.sellPrice * i.qty), 0);
            const deliveryFee = parseFloat(document.getElementById('maxim-fee').value) || 0;
            const grandTotal = cartTotal + deliveryFee;

            const customerName = document.getElementById('checkout-customer-name').value.trim() || 'Walk-in Customer';
            const orderType = document.getElementById('checkout-order-type').value;
            const address = document.getElementById('maxim-address').value.trim();
            const paymentMethod = document.getElementById('selected-payment-method').value;
            const cashTendered = parseFloat(document.getElementById('modal-cash-given').value) || 0;

            if (cashTendered < grandTotal && cashTendered > 0) {
                showMsg('Insufficient Payment', `Payment received ${formatPHP(cashTendered)} is less than total due ${formatPHP(grandTotal)}.`, 'error');
                return;
            }

            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' });
            const dateStr = now.toISOString().split('T')[0];

            state.cart.forEach(cartItem => {
                if (!cartItem.isCustom) {
                    const invItem = state.inventory.find(i => i.id === cartItem.itemId);
                    if (invItem) {
                        invItem.qty = Math.max(0, invItem.qty - cartItem.qty);
                    }
                }
            });

            const totalCost = state.cart.reduce((sum, i) => sum + (i.buyPrice * i.qty), 0);
            const profit = cartTotal - totalCost;
            const itemsSummary = state.cart.map(i => `${i.qty}x ${i.name}`).join(', ');

            const newSale = {
                id: 'sale_' + Date.now(),
                customerName: customerName,
                orderType: orderType,
                address: address,
                deliveryFee: deliveryFee,
                paymentMethod: paymentMethod,
                itemName: itemsSummary,
                qty: state.cart.reduce((sum, i) => sum + i.qty, 0),
                revenue: grandTotal,
                profit: profit,
                cashTendered: cashTendered > 0 ? cashTendered : grandTotal,
                changeDue: cashTendered > grandTotal ? (cashTendered - grandTotal) : 0,
                date: `${dateStr} ${timeStr}`
            };

            state.sales.push(newSale);
            state.cart = [];

            closeModal('modal-checkout');
            saveState();

            const changeMessage = cashTendered > grandTotal ? ` Change: ${formatPHP(cashTendered - grandTotal)}.` : '';
            showMsg('Sale Completed!', `Order for ${customerName} (${orderType}) paid via ${paymentMethod} (${formatPHP(grandTotal)}).${changeMessage}`, 'success');
        }

        // ================= EXPORT FUNCTIONS =================
        function exportSalesToExcel() {
            if (state.sales.length === 0) {
                showMsg('No Sales Data', 'There are no sales logs available to export.', 'error');
                return;
            }

            const headers = ["Date & Time", "Customer Name", "Order Type", "Delivery Fee (PHP)", "Address/Landmark", "Payment Method", "Items Purchased", "Total Revenue (PHP)", "Profit (PHP)", "Amount Received", "Change Due"];

            const rows = state.sales.map(s => [
                `"${s.date || ''}"`,
                `"${(s.customerName || 'Walk-in Customer').replace(/"/g, '""')}"`,
                `"${s.orderType || 'Dine-in / Pickup'}"`,
                `"${(s.deliveryFee || 0).toFixed(2)}"`,
                `"${(s.address || '').replace(/"/g, '""')}"`,
                `"${s.paymentMethod || 'Cash'}"`,
                `"${(s.itemName || '').replace(/"/g, '""')}"`,
                `"${(s.revenue || 0).toFixed(2)}"`,
                `"${(s.profit || 0).toFixed(2)}"`,
                `"${(s.cashTendered || s.revenue || 0).toFixed(2)}"`,
                `"${(s.changeDue || 0).toFixed(2)}"`
            ]);

            const csvContent = "\uFEFF" + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `Lecker_Diner_Sales_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

