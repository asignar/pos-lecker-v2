    <script>
        let state = {
            inventory: JSON.parse(localStorage.getItem('lecker_inventory')) || [],
            sales: JSON.parse(localStorage.getItem('lecker_sales')) || [],
            expenses: JSON.parse(localStorage.getItem('lecker_expenses')) || [],
            cart: []
        };

        let financialChart = null;

        function formatPHP(amount) {
            return '₱' + Number(amount || 0).toLocaleString('en-PH', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function saveState() {
            localStorage.setItem('lecker_inventory', JSON.stringify(state.inventory));
            localStorage.setItem('lecker_sales', JSON.stringify(state.sales));
            localStorage.setItem('lecker_expenses', JSON.stringify(state.expenses));
            refreshAll();
        }

        function showMsg(title, text, type = 'info') {
            document.getElementById('msg-title').innerText = title;
            document.getElementById('msg-text').innerText = text;
            const iconEl = document.getElementById('msg-icon');
            if (type === 'success') {
                iconEl.className = 'w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3 text-xl';
                iconEl.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
            } else if (type === 'error') {
                iconEl.className = 'w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-3 text-xl';
                iconEl.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i>';
            } else {
                iconEl.className = 'w-12 h-12 rounded-2xl bg-diner-50 text-diner-600 flex items-center justify-center mx-auto mb-3 text-xl';
                iconEl.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            }
            document.getElementById('modal-msg').classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        const mobileOverlay = document.getElementById('mobile-overlay');
        const closeSidebarBtn = document.getElementById('close-sidebar');

        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            mobileOverlay.classList.toggle('hidden');
        }

        if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', toggleSidebar);
        if (mobileOverlay) mobileOverlay.addEventListener('click', toggleSidebar);
        if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            const targetEl = document.getElementById('tab-' + tabId);
            if (targetEl) targetEl.classList.add('active');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-white', 'bg-diner-600', 'shadow-md');
                btn.classList.add('text-slate-400', 'hover:bg-slate-800', 'hover:text-slate-200');
            });

            const activeBtn = document.querySelector(`.nav-btn[data-target="${tabId}"]`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-400', 'hover:bg-slate-800', 'hover:text-slate-200');
                activeBtn.classList.add('text-white', 'bg-diner-600', 'shadow-md');
            }

            const titles = {
                pos: 'POS Terminal',
                dashboard: 'Dashboard Overview',
                inventory: 'Menu & Stock Inventory',
                sales: 'Sales Transaction Logs',
                expenses: 'Operating Expenses Tracker',
                analytics: 'Reports & Performance'
            };
            const titleEl = document.getElementById('page-title');
            if (titleEl) titleEl.innerText = titles[tabId] || 'Lecker Diner';

            if (!sidebar.classList.contains('-translate-x-full') && window.innerWidth < 768) {
                toggleSidebar();
            }

            if (tabId === 'analytics') {
                renderCharts();
            }
        }

        // ================= POS TERMINAL & CART =================
        function renderPosGrid() {
            const search = document.getElementById('pos-search').value.toLowerCase();
            const grid = document.getElementById('pos-items-grid');

            const filtered = state.inventory.filter(i => i.name.toLowerCase().includes(search));

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 text-sm">No menu items found. Add items in Inventory tab.</div>`;
                return;
            }

            grid.innerHTML = filtered.map(item => {
                const isOutOfStock = item.qty <= 0;
                return `
                    <div onclick="${isOutOfStock ? '' : `addToCart('${item.id}')`}" class="bg-white rounded-2xl border border-slate-200 p-3.5 shadow-sm transition-all hover:shadow-md cursor-pointer flex flex-col justify-between relative group ${isOutOfStock ? 'opacity-50 cursor-not-allowed' : 'hover:border-diner-500'}">
                        <div>
                            <h5 class="font-bold text-slate-900 text-sm leading-tight line-clamp-2">${item.name}</h5>
                        </div>
                        <div class="mt-3 flex items-center justify-between">
                            <span class="font-black text-diner-600 text-base">${formatPHP(item.sellPrice)}</span>
                            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-lg ${isOutOfStock ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-600'}">
                                ${isOutOfStock ? 'Sold Out' : `Stock: ${item.qty}`}
                            </span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function addToCart(itemId) {
            const item = state.inventory.find(i => i.id === itemId);
            if (!item || item.qty <= 0) return;

            const existing = state.cart.find(c => c.itemId === itemId);
            if (existing) {
                if (existing.qty < item.qty) {
                    existing.qty += 1;
                } else {
                    showMsg('Stock Limit', `Cannot exceed available stock limit (${item.qty}).`, 'error');
                }
            } else {
                state.cart.push({
                    itemId: item.id,
                    name: item.name,
                    sellPrice: item.sellPrice,
                    buyPrice: item.buyPrice,
                    qty: 1,
                    maxQty: item.qty,
                    isCustom: false
                });
            }
            renderCart();
        }

        function addManualSaleToCart() {
            const desc = document.getElementById('manual-sale-desc').value.trim() || 'Custom Order';
            const amount = parseFloat(document.getElementById('manual-sale-amount').value);

            if (isNaN(amount) || amount <= 0) {
                showMsg('Invalid Amount', 'Please enter a valid price for custom item.', 'error');
                return;
            }

            state.cart.push({
                itemId: 'custom_' + Date.now(),
                name: desc,
                sellPrice: amount,
                buyPrice: amount * 0.5,
                qty: 1,
                maxQty: 999,
                isCustom: true
            });

            document.getElementById('manual-sale-desc').value = '';
            document.getElementById('manual-sale-amount').value = '';
            renderCart();
        }

        function updateCartQty(index, delta) {
            const item = state.cart[index];
            if (!item) return;

            const newQty = item.qty + delta;
            if (newQty <= 0) {
                state.cart.splice(index, 1);
            } else if (newQty > item.maxQty) {
                showMsg('Stock Limit', `Cannot exceed remaining stock limit (${item.maxQty}).`, 'error');
            } else {
                item.qty = newQty;
            }
            renderCart();
        }

        function clearCart() {
            state.cart = [];
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items-container');
            if (state.cart.length === 0) {
                container.innerHTML = `
                    <p class="text-center text-slate-400 text-sm py-12 flex flex-col items-center gap-2">
                        <i class="fa-solid fa-basket-shopping text-3xl text-slate-300"></i>
                        Click menu items to add to current order.
                    </p>
                `;
            } else {
                container.innerHTML = state.cart.map((item, index) => `
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm">
                        <div class="flex-1 pr-2">
                            <h6 class="font-bold text-slate-900 leading-tight">${item.name}</h6>
                            <span class="text-xs font-semibold text-diner-600">${formatPHP(item.sellPrice)}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center border border-slate-300 rounded-lg bg-white overflow-hidden">
                                <button onclick="updateCartQty(${index}, -1)" class="px-2 py-0.5 text-slate-600 hover:bg-slate-100 font-bold">-</button>
                                <span class="px-2.5 font-bold text-xs text-slate-800">${item.qty}</span>
                                <button onclick="updateCartQty(${index}, 1)" class="px-2 py-0.5 text-slate-600 hover:bg-slate-100 font-bold">+</button>
                            </div>
                            <span class="font-extrabold text-slate-900 w-16 text-right">${formatPHP(item.sellPrice * item.qty)}</span>
                        </div>
                    </div>
                `).join('');
            }

            const subtotal = state.cart.reduce((sum, i) => sum + (i.sellPrice * i.qty), 0);
            document.getElementById('cart-subtotal').innerText = formatPHP(subtotal);
            document.getElementById('cart-total').innerText = formatPHP(subtotal);
            calculatePosChange();
        }

        function calculatePosChange() {
            const subtotal = state.cart.reduce((sum, i) => sum + (i.sellPrice * i.qty), 0);
            const cashInput = document.getElementById('pos-cash-given');
            if (!cashInput) return;
            const cash = parseFloat(cashInput.value) || 0;
            const change = cash - subtotal;
            const changeEl = document.getElementById('pos-change-due');

            if (changeEl) {
                if (change >= 0) {
                    changeEl.innerText = formatPHP(change);
                    changeEl.className = 'w-full px-3 py-2 bg-emerald-100 border border-emerald-300 rounded-xl text-sm font-black text-emerald-800 flex items-center';
                } else {
                    changeEl.innerText = '₱0.00';
                    changeEl.className = 'w-full px-3 py-2 bg-slate-200/70 border border-slate-300 rounded-xl text-sm font-extrabold text-slate-500 flex items-center';
                }
            }
        }

        // ================= MAXIM DELIVERY & CHECKOUT LOGIC =================
        function toggleDeliveryOptions() {
            const type = document.getElementById('checkout-order-type').value;
            const panel = document.getElementById('maxim-delivery-panel');
            if (type === 'Maxim Delivery') {
                panel.classList.remove('hidden');
                autoCalculateDeliveryFee();
            } else {
                panel.classList.add('hidden');
                document.getElementById('maxim-fee').value = '';
                document.getElementById('maxim-address').value = '';
            }
            updateCheckoutTotals();
        }

        function autoCalculateDeliveryFee() {
            const address = (document.getElementById('maxim-address').value || '').toLowerCase().trim();
            let fee = 20; // Default flat rate for local Buhisan
            let zoneDesc = 'Buhisan Local';
            let rateBadge = 'Standard Buhisan: ₱20.00';

            if (address) {
                // Address-based distance mapping relative to Buhisan Rd, Cebu
                if (address.includes('tisa') || address.includes('katipunan')) {
                    fee = 35;
                    zoneDesc = 'Tisa Area (~2 km)';
                } else if (address.includes('punta') || address.includes('princesa') || address.includes('labangon') || address.includes('tres')) {
                    fee = 45;
                    zoneDesc = 'Labangon / Punta (~3 km)';
                } else if (address.includes('banawa') || address.includes('duterte') || address.includes('pasil') || address.includes('san nicolas')) {
                    fee = 55;
                    zoneDesc = 'Banawa / San Nicolas (~4 km)';
                } else if (address.includes('guadalupe') || address.includes('capitol') || address.includes('colon') || address.includes('carbon') || address.includes('fuente') || address.includes('usc') || address.includes('cit')) {
                    fee = 70;
                    zoneDesc = 'Cebu Uptown / Downtown (~6 km)';
                } else if (address.includes('mandaue') || address.includes('talisay') || address.includes('lahug') || address.includes('it park') || address.includes('sm') || address.includes('ayala')) {
                    fee = 95;
                    zoneDesc = 'Extended Metro Cebu (~8+ km)';
                } else if (address.includes('nazareth') || address.includes('buhisan') || address.includes('purok') || address.includes('diner') || address.includes('lower') || address.includes('upper')) {
                    fee = 20;
                    zoneDesc = 'Buhisan Local (<1 km)';
                } else {
                    // Default baseline for unmapped nearby areas
                    fee = 30;
                    zoneDesc = 'Standard Nearby Area';
                }
                rateBadge = `Auto Fee: ₱${fee}.00 (${zoneDesc})`;
            }

            document.getElementById('maxim-fee').value = fee;
            document.getElementById('maxim-zone-desc').innerText = zoneDesc;
            document.getElementById('maxim-rate-badge').innerText = rateBadge;

            updateCheckoutTotals();
        }

        function updateCheckoutTotals() {
            const cartTotal = state.cart.reduce((sum, i) => sum + (i.sellPrice * i.qty), 0);
            const deliveryFee = parseFloat(document.getElementById('maxim-fee').value) || 0;
            const grandTotal = cartTotal + deliveryFee;

            document.getElementById('checkout-modal-total').innerText = formatPHP(grandTotal);
            
            const tag = document.getElementById('checkout-delivery-tag');
            if (deliveryFee > 0) {
                tag.innerText = `+${formatPHP(deliveryFee)} Maxim Delivery Fee`;
                tag.classList.remove('hidden');
            } else {
                tag.classList.add('hidden');
            }

            calculateModalChange();
        }

        function openCheckoutModal() {
            if (state.cart.length === 0) {
                showMsg('Cart Empty', 'Add items to order before opening checkout.', 'error');
                return;
            }

            const total = state.cart.reduce((sum, i) => sum + (i.sellPrice * i.qty), 0);
            const totalItems = state.cart.reduce((sum, i) => sum + i.qty, 0);

            const checkoutTotalEl = document.getElementById('checkout-modal-total');
            if (checkoutTotalEl) checkoutTotalEl.innerText = formatPHP(total);

            const itemCountEl = document.getElementById('checkout-modal-item-count');
            if (itemCountEl) itemCountEl.innerText = `${totalItems} item(s) in order`;

            const ticketEl = document.getElementById('checkout-modal-ticket');
            if (ticketEl) ticketEl.innerText = (1000 + state.sales.length + 1);

            const custNameEl = document.getElementById('checkout-customer-name');
            if (custNameEl) custNameEl.value = '';

            const orderTypeEl = document.getElementById('checkout-order-type');
            if (orderTypeEl) orderTypeEl.value = 'Dine-in / Pickup';

            const feeEl = document.getElementById('maxim-fee');
            if (feeEl) feeEl.value = '';

            const addrEl = document.getElementById('maxim-address');
            if (addrEl) addrEl.value = '';

            toggleDeliveryOptions();

            const posCashVal = document.getElementById('pos-cash-given') ? document.getElementById('pos-cash-given').value : '';
            const modalCashEl = document.getElementById('modal-cash-given');
