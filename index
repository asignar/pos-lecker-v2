<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecker Diner - POS & Inventory Management</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        diner: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            500: '#e11d48',
                            600: '#be123c',
                            700: '#9f1239',
                            800: '#881337',
                            900: '#4c0519',
                        },
                        amber: {
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col md:flex-row">

    <!-- Mobile Header -->
    <header class="md:hidden bg-slate-900 text-white px-4 py-3 flex items-center justify-between sticky top-0 z-30 shadow-md">
        <div class="flex items-center space-x-3">
            <div class="bg-diner-600 text-white p-2 rounded-xl font-bold flex items-center justify-center w-9 h-9 shadow">
                <i class="fa-solid fa-utensils"></i>
            </div>
            <div>
                <span class="font-extrabold text-base tracking-wide text-white block leading-none">Lecker Diner</span>
                <span class="text-[10px] text-diner-100 font-semibold uppercase tracking-wider">Buhisan, Cebu City</span>
            </div>
        </div>
        <button id="mobile-menu-btn" class="text-slate-300 hover:text-white focus:outline-none p-2 rounded-lg">
            <i class="fa-solid fa-bars text-xl"></i>
        </button>
    </header>

    <!-- Mobile Drawer Overlay -->
    <div id="mobile-overlay" class="fixed inset-0 bg-slate-950/60 z-40 hidden md:hidden transition-opacity backdrop-blur-sm"></div>

    <!-- Sidebar / Navigation -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-slate-900 text-slate-300 flex flex-col transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out md:static md:z-auto shadow-xl">
        <div class="p-5 border-b border-slate-800 hidden md:flex items-center space-x-3">
            <div class="bg-diner-600 text-white p-2.5 rounded-2xl font-bold flex items-center justify-center w-11 h-11 shadow-lg shadow-diner-900/50">
                <i class="fa-solid fa-utensils text-xl"></i>
            </div>
            <div>
                <h1 class="font-extrabold text-white text-lg tracking-tight leading-tight">Lecker Diner</h1>
                <p class="text-[11px] text-diner-100 font-semibold tracking-wide">Nazareth Buhisan, Cebu</p>
            </div>
        </div>

        <div class="p-4 md:hidden flex items-center justify-between border-b border-slate-800 bg-slate-950">
            <span class="font-bold text-white text-sm uppercase tracking-wider">Navigation Menu</span>
            <button id="close-sidebar" class="text-slate-400 hover:text-white p-1">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto">
            <button onclick="switchTab('pos')" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-semibold text-sm transition-all text-white bg-diner-600 shadow-md shadow-diner-900/30" data-target="pos">
                <i class="fa-solid fa-cash-register w-5 text-center text-lg"></i>
                <span>POS Order Terminal</span>
            </button>
            <button onclick="switchTab('dashboard')" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200" data-target="dashboard">
                <i class="fa-solid fa-chart-pie w-5 text-center text-lg"></i>
                <span>Dashboard</span>
            </button>
            <button onclick="switchTab('inventory')" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200" data-target="inventory">
                <i class="fa-solid fa-boxes-stacked w-5 text-center text-lg"></i>
                <span>Inventory & Items</span>
            </button>
            <button onclick="switchTab('sales')" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200" data-target="sales">
                <i class="fa-solid fa-receipt w-5 text-center text-lg"></i>
                <span>Sales Logs</span>
            </button>
            <button onclick="switchTab('expenses')" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200" data-target="expenses">
                <i class="fa-solid fa-wallet w-5 text-center text-lg"></i>
                <span>Expenses Tracker</span>
            </button>
            <button onclick="switchTab('analytics')" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition-all text-slate-400 hover:bg-slate-800 hover:text-slate-200" data-target="analytics">
                <i class="fa-solid fa-chart-line w-5 text-center text-lg"></i>
                <span>Reports & Profit</span>
            </button>
        </nav>

        <div class="p-4 border-t border-slate-800 bg-slate-950/50">
            <div class="bg-slate-800/80 p-3 rounded-xl border border-slate-700/60 flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">System Reset</p>
                    <button onclick="resetAllData()" class="text-xs text-rose-400 hover:text-rose-300 font-semibold mt-1 flex items-center gap-1">
                        <i class="fa-solid fa-trash-can"></i> Clear All Records
                    </button>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Workspace -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
        <!-- Top Workspace Header -->
        <header class="bg-white border-b border-slate-200 px-6 py-4 hidden md:flex items-center justify-between sticky top-0 z-20 shadow-sm">
            <div>
                <h2 id="page-title" class="text-xl font-extrabold text-slate-900 tracking-tight">POS Terminal</h2>
                <p class="text-xs text-slate-500 font-medium">Location: Nazareth, Buhisan Rd, Cebu City | Currency: Philippine Peso (₱)</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold text-slate-600 bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="current-date-display">PH Standard Time</span>
                </span>
            </div>
        </header>

        <div class="p-4 md:p-6 max-w-7xl mx-auto w-full flex-1 flex flex-col">

            <!-- TAB: POS TERMINAL -->
            <div id="tab-pos" class="tab-content active space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                    <!-- Left: Item Menu Matrix -->
                    <div class="lg:col-span-7 xl:col-span-8 space-y-4">
                        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                            <div class="relative flex-1 w-full">
                                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                                <input type="text" id="pos-search" oninput="renderPosGrid()" placeholder="Search diner menu items..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-diner-500 focus:bg-white transition-all">
                            </div>
                        </div>

                        <!-- Menu Items Grid -->
                        <div id="pos-items-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3">
                            <!-- Items injected via JS -->
                        </div>

                        <!-- Manual Quick Custom Sale Entry -->
                        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                            <h4 class="text-sm font-bold text-slate-900 mb-2 flex items-center gap-2">
                                <i class="fa-solid fa-hand-holding-dollar text-diner-600"></i>
                                Custom / Open Price Order
                            </h4>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <input type="text" id="manual-sale-desc" placeholder="Description (e.g. Special Tray)" class="px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-diner-500">
                                <input type="number" id="manual-sale-amount" step="0.01" placeholder="Amount (₱)" class="px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-diner-500">
                                <button onclick="addManualSaleToCart()" class="bg-slate-800 hover:bg-slate-900 text-white font-semibold text-sm px-4 py-2 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-plus"></i> Add Custom Item
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Current Order Cart -->
                    <div class="lg:col-span-5 xl:col-span-4 bg-white rounded-2xl border border-slate-200 shadow-md p-5 flex flex-col min-h-[550px] sticky top-24">
                        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                            <div>
                                <h3 class="font-bold text-slate-900 text-lg">Current Order</h3>
                                <p class="text-xs text-slate-400">Order Ticket #<span id="pos-ticket-num">1001</span></p>
                            </div>
                            <button onclick="clearCart()" class="text-xs text-rose-600 hover:text-rose-700 font-semibold px-2.5 py-1 bg-rose-50 rounded-lg hover:bg-rose-100 transition-colors">
                                Clear Cart
                            </button>
                        </div>

                        <!-- Cart Items List -->
                        <div id="cart-items-container" class="flex-1 overflow-y-auto my-4 space-y-3 pr-1 max-h-[320px]">
                            <p class="text-center text-slate-400 text-sm py-12 flex flex-col items-center gap-2">
                                <i class="fa-solid fa-basket-shopping text-3xl text-slate-300"></i>
                                Click menu items to add to current order.
                            </p>
                        </div>

                        <!-- Cart Totals & Checkout -->
                        <div class="border-t border-slate-100 pt-4 space-y-3 bg-slate-50 -mx-5 -mb-5 p-5 rounded-b-2xl">
                            <div class="flex justify-between text-sm text-slate-600 font-medium">
                                <span>Subtotal</span>
                                <span id="cart-subtotal" class="font-bold text-slate-800">₱0.00</span>
                            </div>
                            <div class="flex justify-between text-base font-extrabold text-slate-900 pt-1 border-t border-slate-200">
                                <span>Total Amount</span>
                                <span id="cart-total" class="text-diner-600 text-xl">₱0.00</span>
                            </div>

                            <!-- Quick Cash Calculator -->
                            <div class="pt-2 grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Cash Tendered (₱)</label>
                                    <input type="number" id="pos-cash-given" oninput="calculatePosChange()" placeholder="0.00" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-diner-500">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Change Due</label>
                                    <div id="pos-change-due" class="w-full px-3 py-2 bg-slate-200/70 border border-slate-300 rounded-xl text-sm font-extrabold text-emerald-700 flex items-center">
                                        ₱0.00
                                    </div>
                                </div>
                            </div>

                            <button onclick="openCheckoutModal()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 rounded-xl text-base transition-all shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2 mt-2">
                                <i class="fa-solid fa-check-circle text-lg"></i> Pay & Complete Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB: DASHBOARD OVERVIEW -->
            <div id="tab-dashboard" class="tab-content space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Revenue</p>
                            <h3 id="stat-revenue" class="text-2xl font-black text-slate-900 mt-1">₱0.00</h3>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-money-bill-trend-up"></i>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Expenses</p>
                            <h3 id="stat-expenses" class="text-2xl font-black text-slate-900 mt-1">₱0.00</h3>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-arrow-down-wide-short"></i>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Net Profit</p>
                            <h3 id="stat-profit" class="text-2xl font-black text-emerald-600 mt-1">₱0.00</h3>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-piggy-bank"></i>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Menu Items</p>
                            <h3 id="stat-inventory" class="text-2xl font-black text-slate-900 mt-1">0</h3>
                            <p id="stat-lowstock" class="text-xs text-amber-600 font-semibold mt-0.5">0 low stock alerts</p>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-extrabold text-slate-900 text-base">Recent Sales Transactions</h4>
                            <button onclick="switchTab('sales')" class="text-xs font-bold text-diner-600 hover:text-diner-700">View All →</button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[11px] border-y border-slate-100">
                                    <tr>
                                        <th class="p-3">Date</th>
                                        <th class="p-3">Customer</th>
                                        <th class="p-3">Items</th>
                                        <th class="p-3">Total (₱)</th>
                                    </tr>
                                </thead>
                                <tbody id="dashboard-recent-sales" class="divide-y divide-slate-100">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="lg:col-span-4 bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <h4 class="font-extrabold text-slate-900 text-base flex items-center gap-2">
                                    <i class="fa-solid fa-triangle-exclamation text-amber-500"></i> Stock Warnings
                                </h4>
                                <span id="low-stock-badge" class="bg-amber-100 text-amber-800 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
                            </div>
                            <div id="low-stock-list" class="space-y-2 max-h-[280px] overflow-y-auto">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB: INVENTORY & MENU ITEMS -->
            <div id="tab-inventory" class="tab-content space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="flex flex-1 items-center gap-3">
                        <div class="relative flex-1">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                            <input type="text" id="inventory-search" oninput="renderInventory()" placeholder="Search inventory by item name..." class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-diner-500">
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="exportInventoryToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-sm transition-all shadow flex items-center justify-center gap-2 whitespace-nowrap">
                            <i class="fa-solid fa-file-excel"></i> Export Excel
                        </button>
                        <button onclick="openInventoryModal()" class="bg-diner-600 hover:bg-diner-700 text-white font-bold px-4 py-2 rounded-xl text-sm transition-all shadow flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus"></i> Add Menu Item
                        </button>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[11px] border-b border-slate-200">
                                <tr>
                                    <th class="p-4">Item Name</th>
                                    <th class="p-4">Stock Qty</th>
                                    <th class="p-4">Cost (₱)</th>
                                    <th class="p-4">Price (₱)</th>
                                    <th class="p-4">Status</th>
                                    <th class="p-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="inventory-table-body" class="divide-y divide-slate-100">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB: SALES LOGS -->
            <div id="tab-sales" class="tab-content space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="relative flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                        <input type="text" id="sales-search" oninput="renderSales()" placeholder="Search transactions by item or customer..." class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-diner-500">
                    </div>
                    <div class="flex items-center gap-2">
                        <select id="sales-filter-payment" onchange="renderSales()" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-diner-500">
                            <option value="">All Payment Methods</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Maya">Maya</option>
                            <option value="Bank">Bank</option>
                        </select>
                        <button onclick="exportSalesToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-sm transition-all shadow flex items-center justify-center gap-2 whitespace-nowrap">
                            <i class="fa-solid fa-file-excel"></i> Export Excel
                        </button>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[11px] border-b border-slate-200">
                                <tr>
                                    <th class="p-4">Date & Time</th>
                                    <th class="p-4">Customer</th>
                                    <th class="p-4">Order Type</th>
                                    <th class="p-4">Payment</th>
                                    <th class="p-4">Items</th>
                                    <th class="p-4">Delivery Fee (₱)</th>
                                    <th class="p-4">Total Paid (₱)</th>
                                    <th class="p-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="sales-table-body" class="divide-y divide-slate-100">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB: EXPENSES TRACKER -->
            <div id="tab-expenses" class="tab-content space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <div>
                        <h4 class="font-extrabold text-slate-900 text-base">Diner Operating Expenses</h4>
                        <p class="text-xs text-slate-500">Track raw materials restock, utility bills, and kitchen costs.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="exportExpensesToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-sm transition-all shadow flex items-center justify-center gap-2 whitespace-nowrap">
                            <i class="fa-solid fa-file-excel"></i> Export Excel
                        </button>
                        <button onclick="openExpenseModal()" class="bg-diner-600 hover:bg-diner-700 text-white font-bold px-4 py-2 rounded-xl text-sm transition-all shadow flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus"></i> Record Expense
                        </button>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[11px] border-b border-slate-200">
                                <tr>
                                    <th class="p-4">Date</th>
                                    <th class="p-4">Description</th>
                                    <th class="p-4">Amount (₱)</th>
                                    <th class="p-4 text-right">Actions</th>
                                </tr>
                            </thead>
