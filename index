        // ================= DASHBOARD METRICS =================
        function refreshDashboard() {
            const totalRevenue = state.sales.reduce((sum, s) => sum + s.revenue, 0);
            const totalExpenses = state.expenses.reduce((sum, e) => sum + e.amount, 0);
            const netProfit = totalRevenue - totalExpenses;
            const totalItemsCount = state.inventory.reduce((sum, i) => sum + i.qty, 0);
            const lowStockItems = state.inventory.filter(i => i.qty <= 5);

            document.getElementById('stat-revenue').innerText = formatPHP(totalRevenue);
            document.getElementById('stat-expenses').innerText = formatPHP(totalExpenses);

            const profitEl = document.getElementById('stat-profit');
            profitEl.innerText = formatPHP(netProfit);
            profitEl.className = netProfit >= 0 ? 'text-2xl font-black text-emerald-600 mt-1' : 'text-2xl font-black text-rose-600 mt-1';

            document.getElementById('stat-inventory').innerText = totalItemsCount;
            document.getElementById('low-stock-badge').innerText = lowStockItems.length;
            document.getElementById('stat-lowstock').innerText = `${lowStockItems.length} low stock alerts`;

            const recentSalesBody = document.getElementById('dashboard-recent-sales');
            const sortedSales = [...state.sales].sort((a,b) => new Date(b.date) - new Date(a.date)).slice(0, 5);
            if (sortedSales.length === 0) {
                recentSalesBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400">No transactions recorded yet.</td></tr>`;
            } else {
                recentSalesBody.innerHTML = sortedSales.map(s => `
                    <tr>
                        <td class="p-3 text-xs text-slate-500">${s.date}</td>
                        <td class="p-3 font-bold text-slate-900">${s.customerName || 'Walk-in'}</td>
                        <td class="p-3 text-xs font-semibold text-slate-800">${s.itemName}</td>
                        <td class="p-3 font-extrabold text-slate-900">${formatPHP(s.revenue)}</td>
                    </tr>
                `).join('');
            }

            const lowStockList = document.getElementById('low-stock-list');
            if (lowStockItems.length === 0) {
                lowStockList.innerHTML = `<p class="text-sm text-slate-400 text-center py-6">All menu item stocks are sufficient.</p>`;
            } else {
                lowStockList.innerHTML = lowStockItems.map(i => `
                    <div class="flex items-center justify-between p-3 bg-amber-50 border border-amber-200 rounded-xl">
                        <div>
                            <p class="font-bold text-slate-900 text-sm">${i.name}</p>
                            <p class="text-xs text-amber-800 font-semibold">Remaining Stock: ${i.qty}</p>
                        </div>
                        <button onclick="openInventoryModal('${i.id}')" class="bg-amber-600 hover:bg-amber-700 text-white text-xs px-3 py-1.5 rounded-lg font-bold shadow-sm">Restock</button>
                    </div>
                `).join('');
            }
        }

        // ================= ANALYTICS & CHARTS =================
        function renderCharts() {
            const ctxFin = document.getElementById('chartFinancial').getContext('2d');
            const totalRevenue = state.sales.reduce((sum, s) => sum + s.revenue, 0);
            const totalExpenses = state.expenses.reduce((sum, e) => sum + e.amount, 0);

            if (financialChart) financialChart.destroy();
            financialChart = new Chart(ctxFin, {
                type: 'bar',
                data: {
                    labels: ['Total Revenue (₱)', 'Expenses (₱)', 'Net Profit (₱)'],
                    datasets: [{
                        label: 'Philippine Peso (₱)',
                        data: [totalRevenue, totalExpenses, totalRevenue - totalExpenses],
                        backgroundColor: ['#10b981', '#be123c', '#4f46e5'],
                        borderRadius: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });
        }

        function refreshAll() {
            renderInventory();
            renderSales();
            renderExpenses();
            refreshDashboard();
            renderCart();
            if (document.getElementById('tab-analytics').classList.contains('active')) {
                renderCharts();
            }
        }

        function resetAllData() {
            state = { inventory: [], sales: [], expenses: [], cart: [] };
            saveState();
            showMsg('Data Wiped', 'All business data has been reset.', 'info');
        }

        window.onload = function() {
            refreshAll();

            const dateDisp = document.getElementById('current-date-display');
            if (dateDisp) {
                const now = new Date();
                dateDisp.innerText = now.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
            }
        };
    </script>
</body>
</html>
