        function selectPaymentMethod(method) {
            document.getElementById('selected-payment-method').value = method;

            document.querySelectorAll('.pay-method-btn').forEach(btn => {
                btn.className = 'pay-method-btn border-2 border-slate-200 hover:border-slate-300 text-slate-700 font-extrabold py-2.5 px-2 rounded-xl text-xs flex flex-col items-center gap-1 transition-all';
            });

